# Leave empty to run in demo mode (no AI calls, drafts are generated offline).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any model that accepts images and JSON output works.
GEMINI_MODEL=gemini-flash-latest

# Comma-separated list of frontends allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the SQLite database and uploaded photos are kept.
# DATA_DIR=./data

# MAX_UPLOAD_MB=8
# AI_TIMEOUT_SECONDS=45
# DEMO_MODE=false
